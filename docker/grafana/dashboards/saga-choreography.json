{
  "title": "SAGA Choreography - Overview",
  "uid": "saga-choreography",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Orders Created (rate/min)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{
        "expr": "rate(http_server_requests_seconds_count{uri='/api/v1/orders', method='POST', job='order-service'}[1m]) * 60",
        "legendFormat": "orders/min"
      }],
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } } }
    },
    {
      "id": 2,
      "title": "HTTP Error Rate - Order Service",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{
        "expr": "sum(rate(http_server_requests_seconds_count{job='order-service', status=~'5..'}[1m]))",
        "legendFormat": "errors/min"
      }],
      "options": { "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } }
    },
    {
      "id": 3,
      "title": "JVM Heap Used (MB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "jvm_memory_used_bytes{area='heap', job='order-service'} / 1024 / 1024", "legendFormat": "order-service" },
        { "expr": "jvm_memory_used_bytes{area='heap', job='payment-service'} / 1024 / 1024", "legendFormat": "payment-service" },
        { "expr": "jvm_memory_used_bytes{area='heap', job='inventory-service'} / 1024 / 1024", "legendFormat": "inventory-service" }
      ],
      "fieldConfig": { "defaults": { "unit": "MiB" } }
    },
    {
      "id": 4,
      "title": "Service Health",
      "type": "table",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "up{job=~'order-service|payment-service|inventory-service'}", "legendFormat": "{{job}}", "instant": true }
      ],
      "options": { "sortBy": [{ "displayName": "job", "desc": false }] }
    },
    {
      "id": 5,
      "title": "HTTP Request Duration p99 (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket{job='order-service'}[1m]))", "legendFormat": "order-service p99" },
        { "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket{job='payment-service'}[1m]))", "legendFormat": "payment-service p99" },
        { "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket{job='inventory-service'}[1m]))", "legendFormat": "inventory-service p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "title": "Kafka Consumer Lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "kafka_consumer_fetch_manager_records_lag{job='order-service'}", "legendFormat": "order-service {{topic}}" },
        { "expr": "kafka_consumer_fetch_manager_records_lag{job='payment-service'}", "legendFormat": "payment-service {{topic}}" },
        { "expr": "kafka_consumer_fetch_manager_records_lag{job='inventory-service'}", "legendFormat": "inventory-service {{topic}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 7,
      "title": "JVM Threads",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "jvm_threads_live_threads{job='order-service'}", "legendFormat": "order-service" },
        { "expr": "jvm_threads_live_threads{job='payment-service'}", "legendFormat": "payment-service" },
        { "expr": "jvm_threads_live_threads{job='inventory-service'}", "legendFormat": "inventory-service" }
      ]
    },
    {
      "id": 8,
      "title": "DB Connection Pool Active",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "hikaricp_connections_active{job='order-service'}", "legendFormat": "order-service" },
        { "expr": "hikaricp_connections_active{job='payment-service'}", "legendFormat": "payment-service" },
        { "expr": "hikaricp_connections_active{job='inventory-service'}", "legendFormat": "inventory-service" }
      ]
    }
  ]
}
